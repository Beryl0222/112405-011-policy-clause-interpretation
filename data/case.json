{
  "case_id": "case-policy-clause-interpretation",
  "records": [
    {
      "id": "IC-BASE",
      "kind": "主条款",
      "text": "P8自2026-01-01起承保。第一节设备包括附表主机及固定附属件。第二节意外进水的直接修理费纳入；未经保险人批准的维修费不纳入，但避免损失扩大而立即排水的费用不受该批准条件限制。第三节每次事故先扣200元免赔，余款累计不超过事故限额。"
    },
    {
      "id": "IC-TABLE",
      "kind": "附表",
      "text": "主机A及固定泵B共用事故限额5000元，可移动监测器C未列入。一次上门服务不可重复列报。"
    },
    {
      "id": "IC-E1",
      "kind": "批单",
      "text": "P9的E1自七月一日起，将第二节批准条件改为：未经批准不纳入维修费，但为恢复应急供水而进行的紧急抢修除外。其他文字不变。"
    },
    {
      "id": "IC-E2",
      "kind": "批单",
      "text": "P9的E2适用于七月一日后事故：紧急抢修费仍须保险人书面批准。与E1同级，未说明替代关系。"
    },
    {
      "id": "IC-E3",
      "kind": "追溯批单",
      "text": "E3将E1扩大保障用于六月二十日后且未结案事故；已结案赔付和第一节设备范围不变。"
    },
    {
      "id": "IC-F1",
      "kind": "假设事实",
      "text": "六月二十五日泵B意外进水，排水100元、应急供水抢修2400元，七月二日补书面批准。事前是否口头批准不明。"
    },
    {
      "id": "IC-F2",
      "kind": "假设事实",
      "text": "七月五日主机A意外进水，修理4800元、泵B修理900元，两张报价均含服务费300元。批准已确认，是否同一次上门未知。"
    },
    {
      "id": "IC-F3",
      "kind": "假设事实",
      "text": "监测器C进水已批准维修，客户说平时固定摆在主机旁。"
    },
    {
      "id": "IC-N1",
      "kind": "编辑意见",
      "text": "E1除外只恢复抢修的批准条件，不取消免赔。E2是否覆盖E1待负责人确认。此意见未签认。"
    },
    {
      "id": "IC-H1",
      "kind": "案件记录",
      "text": "CASE-C在六月二十六日结案，二十七日客户收到解释。"
    },
    {
      "id": "IC-WEB",
      "kind": "宣传文案",
      "text": "紧急情况可以先抢修，我们提供贴心保障；此页不是合同。"
    }
  ],
